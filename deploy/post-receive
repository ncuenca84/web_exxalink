#!/bin/bash
#
# Hook de despliegue — Exxalink S.A.S.
# Se ejecuta en el servidor tras cada 'git push' al repo bare.
# Hace checkout del sitio en public_html y restablece propietario/permisos
# del usuario exxa. NUNCA toca my.exxalink.com (no está versionado).
#
set -euo pipefail

# ------------------- Configuración -------------------
DEPLOY_BRANCH="main"                               # rama que se publica
WORK_TREE="/home/exxa/public_html"                 # raíz del sitio
GIT_DIR="/home/exxa/repos/web_exxalink.git"        # repo bare
OWNER="exxa"                                        # usuario propietario
GROUP="exxa"                                         # grupo propietario
# -----------------------------------------------------

while read -r oldrev newrev ref; do
    if [ "$ref" != "refs/heads/$DEPLOY_BRANCH" ]; then
        echo "[deploy] Rama '$ref' ignorada (solo se publica '$DEPLOY_BRANCH')."
        continue
    fi

    echo "[deploy] Publicando '$DEPLOY_BRANCH' en $WORK_TREE ..."
    git --work-tree="$WORK_TREE" --git-dir="$GIT_DIR" checkout -f "$DEPLOY_BRANCH"

    echo "[deploy] Restableciendo propietario y permisos (solo archivos del proyecto)..."
    # Recorre SOLO las entradas de primer nivel versionadas.
    # Como my.exxalink.com no está en git, jamás se lista aquí.
    while IFS= read -r top; do
        target="$WORK_TREE/$top"
        [ -e "$target" ] || continue
        chown -R "$OWNER:$GROUP" "$target"
        find "$target" -type d -exec chmod 755 {} \;
        find "$target" -type f -exec chmod 644 {} \;
    done < <(git --git-dir="$GIT_DIR" ls-tree --name-only "$DEPLOY_BRANCH")

    # Carpeta de QR: debe poder escribir PHP.
    mkdir -p "$WORK_TREE/certificados/qrs"
    chown "$OWNER:$GROUP" "$WORK_TREE/certificados/qrs"
    chmod 755 "$WORK_TREE/certificados/qrs"

    # config.php (credenciales) con permisos restrictivos, si existe.
    if [ -f "$WORK_TREE/certificados/config.php" ]; then
        chown "$OWNER:$GROUP" "$WORK_TREE/certificados/config.php"
        chmod 600 "$WORK_TREE/certificados/config.php"
    fi

    echo "[deploy] ✔ Despliegue completado."
done
