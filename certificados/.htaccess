# Seguridad del sistema de certificados — Exxalink S.A.S.
# (Ámbito: solo la carpeta /certificados/. No afecta a otros subdominios.)

# Desactivar el listado de directorios.
Options -Indexes

# Bloquear el acceso web a archivos sensibles (config, SQL, logs, docs...).
<FilesMatch "(?i)(^config\.php$|\.sql$|\.log$|\.md$|\.txt$|^error_log$|\.example\.php$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Cabeceras de seguridad (refuerzo; las páginas PHP también las envían).
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "no-referrer"
</IfModule>
